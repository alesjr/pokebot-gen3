POKEBOT_WEB_USERNAME=admin
# Gere com: docker compose run --rm --no-deps pokebot python utility/hash_dashboard_password.py
# Compose exige $$ para preservar caracteres do hash Argon2 dentro do .env.
POKEBOT_WEB_PASSWORD_HASH=$$argon2id$$v=19$$m=65536,t=3,p=4$$SUBSTITUA_PELO_HASH
POKEBOT_WEB_SESSION_SECRET=substitua-por-um-segredo-aleatorio-de-32-caracteres
POKEBOT_PROFILE=Sapphire
POKEBOT_MODE=Living Dex Gen III
POKEBOT_EMULATION_SPEED=0
POKEBOT_DASHBOARD_PORT=8888
POKEBOT_COOKIE_SECURE=1
POKEBOT_PROFILE_PORTS=Sapphire:8888,Ruby:8889,FR:8891
